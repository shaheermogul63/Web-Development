<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>404 - Page Not Found | Majestic Marquee</title>
  <link rel="stylesheet" href="/css/style.css">
  <style>
    .error-page {
      display: flex;
      align-items: center;
      justify-content: center;
      min-height: 100vh;
      background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    }
    .error-content {
      text-align: center;
      color: white;
      padding: 40px;
    }
    .error-content h1 {
      font-size: 120px;
      margin: 0;
      font-weight: bold;
    }
    .error-content p {
      font-size: 24px;
      margin: 20px 0;
    }
    .error-content a {
      display: inline-block;
      margin-top: 30px;
      padding: 12px 30px;
      background: white;
      color: #667eea;
      text-decoration: none;
      border-radius: 5px;
      font-weight: bold;
      transition: 0.3s;
    }
    .error-content a:hover {
      transform: translateY(-2px);
      box-shadow: 0 10px 20px rgba(0,0,0,0.2);
    }
  </style>
</head>
<body>
  <div class="error-page">
    <div class="error-content">
      <h1>404</h1>
      <p>Page Not Found</p>
      <p>Sorry, the page you are looking for doesn't exist.</p>
      <a href="/">Go Back Home</a>
    </div>
  </div>
</body>
</html>
